<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_material_distribution_report" model="ir.actions.report">
        <field name="name">Material Distribution Report</field>
        <field name="model">material.distribution</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">general_service.material_distribution_report_template</field>
        <field name="report_file">general_service.material_distribution_report_template</field>
        <field name="print_report_name">'Material Distribution - %s' % object.name</field>
        <field name="binding_model_id" ref="model_material_distribution"/>
        <field name="binding_type">report</field>
    </record>

    <template id="material_distribution_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="row">
                        <div class="col-12 text-center">
                            <h3>Material Distribution Report</h3>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>Reference:</strong> <span t-esc="o.name"/><br/>
                            <strong>Date:</strong> <span t-esc="o.date"/><br/>
                        </div>
                        <div class="col-6">
                            <strong>Notes:</strong> <span t-esc="o.notes"/><br/>
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Material Distribution Table:</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <t t-set="materials" t-value="sorted(list(set([l.material for l in o.line_ids])))"/>
                                        <t t-foreach="materials" t-as="mat">
                                            <th><span t-esc="mat"/></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.employee_ids" t-as="emp">
                                        <tr>
                                            <td><span t-esc="emp.name"/></td>
                                            <t t-foreach="materials" t-as="mat">
                                                <td>
                                                    <t t-set="qty" t-value="sum([l.quantity for l in o.line_ids if l.material == mat])"/>
                                                    <span t-esc="qty if qty else ''"/>
                                                </td>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo> 