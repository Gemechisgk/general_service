<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_airplane_ticket_form" model="ir.ui.view">
        <field name="name">airplane.ticket.form</field>
        <field name="model">airplane.ticket</field>
        <field name="arch" type="xml">
            <form string="Airplane Ticket Request">
                <header>
                    <button name="action_submit" string="Book Ticket" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" string="Mark as Completed" type="object" class="oe_highlight"
                            invisible="state != 'booked'"/>
                    <button name="action_print_request" string="Print" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,booked,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Requester Details">
                            <field name="requester_id"/>
                            <field name="department_id"/>
                            <field name="contact_number"/>
                            <field name="reason_for_travel"/>
                            <field name="origin"/>
                            <field name="destination"/>
                            <field name="travel_type"/>
                        </group>
                        <group string="Travel Details">
                            <field name="travel_agent_id"/>
                            <field name="contract_reference"/>
                            <field name="flight_number"/>
                            <field name="departure_date"/>
                            <field name="departure_time" widget="float_time"/>
                            <field name="return_date" invisible="travel_type == 'one_way'" required="travel_type == 'round_trip'"/>
                            <field name="ticket_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Flight Details">
                            <group>
                                <field name="flight_details_attachment" filename="flight_details_filename"/>
                                <field name="flight_details_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_airplane_ticket_list" model="ir.ui.view">
        <field name="name">airplane.ticket.list</field>
        <field name="model">airplane.ticket</field>
        <field name="arch" type="xml">
            <list string="Airplane Ticket Requests" decoration-info="state == 'draft'" 
                  decoration-primary="state == 'booked'"
                  decoration-muted="state == 'completed'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="departure_date"/>
                <field name="travel_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_airplane_ticket_search" model="ir.ui.view">
        <field name="name">airplane.ticket.search</field>
        <field name="model">airplane.ticket</field>
        <field name="arch" type="xml">
            <search string="Airplane Ticket Requests">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="travel_agent_id"/>
                <field name="state"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Booked" name="booked" domain="[('state', '=', 'booked')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Requester" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_airplane_ticket" model="ir.actions.act_window">
        <field name="name">Airplane Tickets</field>
        <field name="res_model">airplane.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first airplane ticket request!
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_airplane_ticket"
              name="Airplane Tickets"
              parent="menu_general_service_root"
              sequence="40"/>
              
    <menuitem id="menu_airplane_ticket_request"
              name="Ticket Requests"
              parent="menu_airplane_ticket"
              action="action_airplane_ticket"
              sequence="10"/>
</odoo> 